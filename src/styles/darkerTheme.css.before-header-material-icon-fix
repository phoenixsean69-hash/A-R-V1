  }

  .roadsafe-workspace-title {
    padding-left: 8px;
  }

  .roadsafe-workspace-title h1 {
    font-size: 13px;
  }

  .roadsafe-workspace-title > p:last-child,
  .roadsafe-workspace-title .roadsafe-eyebrow {
    display: none;
  }

  .roadsafe-page-stage,
  .roadsafe-page-stage.is-dashboard {
    padding: 8px;
  }

  .roadsafe-profile-trigger {
    padding: 4px;
  }
}

.roadsafe-mobile-overlay {
  position: fixed;
  inset: 0;
  border: 0;
  background: rgba(18, 22, 26, 0.58);
  backdrop-filter: blur(2px);
}

@media print {
  html,
  body,
  #root,
  .roadsafe-workstation,
  .roadsafe-center,
