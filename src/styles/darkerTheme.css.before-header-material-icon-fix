.ui-icon-button {
  width: 32px;
  display: grid;
  place-items: center;
  padding: 0 !important;
}

.ui-button:hover,
.ui-icon-button:hover {
  border-color: var(--js-border-strong) !important;
  background: var(--js-panel-hover) !important;
  color: var(--js-text-primary) !important;
}

.ui-button-primary {
  border-color: var(--js-blue-muted) !important;
  background: var(--js-blue-active) !important;
  color: var(--js-text-primary) !important;
}

.ui-button-primary:hover {
  border-color: var(--js-border-strong) !important;
  background: #6b8395 !important;
}

.ui-button:disabled,
.ui-icon-button:disabled {
  border-color: var(--js-border-subtle) !important;
  background: var(--js-panel) !important;
  color: var(--js-text-disabled) !important;
  cursor: not-allowed;
}

.ui-input,
input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
select,
textarea {
  border-color: var(--js-border-default) !important;
  border-radius: var(--js-radius-sm) !important;
  background-color: var(--js-panel-raised) !important;
  color: var(--js-text-primary) !important;
  box-shadow: none !important;
}

input::placeholder,
textarea::placeholder {
  color: var(--js-text-disabled) !important;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--js-blue-active) !important;
  outline: 2px solid color-mix(in srgb, var(--js-blue-active) 26%, transparent) !important;
  outline-offset: 1px;
  box-shadow: none !important;
}

.ui-badge {
  display: inline-flex;
  align-items: center;
  min-height: 20px;
  padding: 2px 6px;
  border: 1px solid var(--js-border-default) !important;
  border-radius: var(--js-radius-sm) !important;
  background: var(--js-panel-raised) !important;
  color: var(--js-text-secondary) !important;
  font-size: 7px;
  font-weight: 720;
}

.ui-badge.is-info {
  border-color: var(--js-info-muted) !important;
  background: var(--js-blue-soft-bg) !important;
}

.ui-badge.is-success {
  border-color: var(--js-green-muted) !important;
  background: var(--js-green-bg) !important;
}

.ui-badge.is-warning {
  border-color: var(--js-amber-muted) !important;
  background: var(--js-amber-bg) !important;
}

.ui-badge.is-danger {
  border-color: var(--js-red-muted) !important;
  background: var(--js-red-bg) !important;
}

.ui-badge.is-neutral {
  border-color: var(--js-border-default) !important;
  background: var(--js-panel-raised) !important;
}

.reconstruction-editor [class*="bg-blue-"],
