@media (min-width: 1024px) {
  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-brand-copy,
  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-station-copy,
  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-group-label,
  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-link-label,
  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-case,
  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-footer-copy {
    display: none;
  }

  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-brand,
  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-station,
  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-footer {
    justify-content: center;
    padding-right: 8px;
    padding-left: 8px;
  }

  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-brand-link {
    flex: 0 0 auto;
  }

  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-collapse {
    position: absolute;
    top: 50px;
    right: -13px;
    z-index: 5;
    width: 26px;
    min-height: 26px;
    border-radius: 999px !important;
  }

  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-group + .roadsafe-navigation-group {
    margin-top: 6px;
  }

  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-link {
    justify-content: center;
    padding: 8px;
  }

  .roadsafe-workstation.is-navigation-collapsed
    .roadsafe-navigation-link.is-active::before {
    display: none;
  }
}

@media (max-width: 1279px) {
  .roadsafe-workstation,
  .roadsafe-workstation.is-navigation-collapsed,
  .roadsafe-workstation.is-inspector-open,
  .roadsafe-workstation.is-navigation-collapsed.is-inspector-open,
  .roadsafe-workstation.is-editor-route,
  .roadsafe-workstation.is-navigation-collapsed.is-editor-route {
    grid-template-columns:
      var(--js-navigation-width)
      minmax(0, 1fr);
  }

  .roadsafe-inspector {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 90;
    width: min(var(--js-inspector-width), 94vw);
    transform: translateX(102%);
    transition: transform 160ms ease;
  }

  .roadsafe-workstation.is-mobile-inspector-open
    .roadsafe-inspector {
    transform: translateX(0);
  }

  .roadsafe-inspector-overlay {
    z-index: 85;
  }

  .roadsafe-workstation.is-mobile-inspector-open
    .roadsafe-inspector-overlay {
    display: block;
  }
}

@media (max-width: 1023px) {
  .roadsafe-workstation,
  .roadsafe-workstation.is-navigation-collapsed,
  .roadsafe-workstation.is-inspector-open,
  .roadsafe-workstation.is-navigation-collapsed.is-inspector-open,
  .roadsafe-workstation.is-editor-route,
  .roadsafe-workstation.is-navigation-collapsed.is-editor-route {
    display: block;
  }

  .roadsafe-navigation {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    width: min(var(--js-navigation-width), 92vw);
    transform: translateX(-102%);
    transition: transform 160ms ease;
  }

  .roadsafe-workstation.is-mobile-navigation-open
    .roadsafe-navigation {
    transform: translateX(0);
  }

  .roadsafe-navigation-collapse {
    display: none !important;
  }

  .roadsafe-navigation-mobile-close,
  .roadsafe-mobile-menu-button {
    display: grid !important;
  }

  .roadsafe-navigation-mobile-close {
    margin-left: auto;
  }

  .roadsafe-navigation-overlay {
    z-index: 85;
  }

  .roadsafe-workstation.is-mobile-navigation-open
    .roadsafe-navigation-overlay {
    display: block;
  }

  .roadsafe-center {
    min-height: 100vh;
  }

  .roadsafe-workspace-header {
    padding-left: 10px;
  }
}

@media (max-width: 860px) {
  .roadsafe-active-case-chip,
  .roadsafe-header-clock,
  .roadsafe-header-icon,
  .roadsafe-inspector-toggle > span,
  .roadsafe-profile-copy {
    display: none !important;
  }

  .roadsafe-inspector-toggle {
    width: 34px;
    justify-content: center;
