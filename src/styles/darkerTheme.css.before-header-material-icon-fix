    display: block !important;
  }
}

/* --------------------------------------------------------------------------
 * Blender-inspired precision UI pass
 * --------------------------------------------------------------------------
 * Visual language derived from the supplied Blender 2.90 reference:
 * compact charcoal bars, inset controls, blue selection rows and orange
 * active-state markers. RoadSafe keeps its own information architecture.
 */

:root {
  --blender-topbar: #1f1f1f;
  --blender-header: #292929;
  --blender-region: #303030;
  --blender-control-top: #4a4a4a;
  --blender-control-bottom: #393939;
  --blender-control-hover-top: #555555;
  --blender-control-hover-bottom: #444444;
  --blender-control-pressed: #2c2c2c;
  --blender-blue: #e8872d;
  --blender-blue-dark: #2f527a;
  --blender-orange: #e8872d;
  --blender-orange-soft: #6a4728;
  --blender-grid-line: rgba(255, 255, 255, 0.035);
  --blender-inset-highlight: rgba(255, 255, 255, 0.075);
  --blender-inset-shadow: rgba(0, 0, 0, 0.48);
}

body {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 11px;
}

.roadsafe-workstation {
  background: var(--js-shell);
}

.roadsafe-center,
.roadsafe-workspace-main {
  background: var(--js-workspace);
}

/* Region borders: thin, dark and flush like Blender editors. */
.roadsafe-navigation,
.roadsafe-inspector,
.roadsafe-workspace-header,
.reconstruction-workspace__header,
.reconstruction-workspace__toolbar,
.reconstruction-workspace__properties,
.reconstruction-workspace__context-panel,
.reconstruction-workspace__canvas,
.reconstruction-workspace__timeline {
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.025),
    inset 0 -1px 0 rgba(0, 0, 0, 0.38);
}

.roadsafe-navigation {
  border-right-color: #111 !important;
  background: #242424;
}

.roadsafe-navigation-brand {
  min-height: var(--js-header-height);
  gap: 5px;
  padding: 4px 5px;
  border-bottom-color: #111;
  background: var(--blender-topbar);
}

.roadsafe-brand-mark {
  width: 30px;
  height: 30px;
  flex-basis: 30px;
  border-color: #555;
  border-radius: 2px;
  background: linear-gradient(#3f3f3f, #303030);
  color: #d7d7d7;
  box-shadow:
    inset 0 1px 0 var(--blender-inset-highlight),
    inset 0 -1px 0 var(--blender-inset-shadow);
}

.roadsafe-brand-link:hover .roadsafe-brand-mark,
.roadsafe-brand-link:focus-visible .roadsafe-brand-mark {
  border-color: var(--blender-orange);
  color: #fff;
}

.roadsafe-brand-copy strong {
  font-size: 11px;
  letter-spacing: 0.035em;
}

.roadsafe-brand-copy small,
.roadsafe-station-copy small,
.roadsafe-navigation-footer-copy small,
.roadsafe-profile-copy small {
  margin-top: 1px;
  font-size: 8px;
  letter-spacing: 0.04em;
}

.roadsafe-navigation-station {
  min-height: 36px;
  gap: 7px;
  padding: 4px 6px;
  border-bottom-color: #151515;
  background: #2a2a2a;
}

.roadsafe-station-symbol {
  width: 25px;
  height: 25px;
  flex-basis: 25px;
  border-color: #4b4b4b;
  background: #353535;
}

.roadsafe-navigation-groups {
  padding: 5px 4px 8px;
}

.roadsafe-navigation-group + .roadsafe-navigation-group {
  margin-top: 7px;
}

.roadsafe-navigation-group-label,
.roadsafe-eyebrow {
  color: #858585;
  font-size: 8px;
  letter-spacing: 0.08em;
}

.roadsafe-navigation-group-label {
  padding: 3px 7px 4px;
}

.roadsafe-navigation-links {
  gap: 1px;
}

.roadsafe-navigation-link {
  position: relative;
  min-height: 27px;
  gap: 7px;
  padding: 4px 7px;
  border: 1px solid transparent;
  border-radius: 2px;
  color: #c5c5c5;
  font-size: 10px;
  font-weight: 500;
}

.roadsafe-navigation-link:hover {
  border-color: #4a4a4a;
  background: #333;
  color: #f1f1f1;
}

.roadsafe-navigation-link.is-active {
  border-color: #e8872d;
  background: #e8872d;
  color: #fff;
  box-shadow:
    inset 2px 0 0 var(--blender-orange),
    inset 0 1px 0 rgba(255, 255, 255, 0.07),
    inset 0 -1px 0 rgba(0, 0, 0, 0.35);
}

.roadsafe-navigation-link.is-active::before {
  display: none;
}

.roadsafe-navigation-case {
  margin: 0 5px 5px;
  padding: 7px;
  border-color: #151515;
  border-radius: 2px;
  background: #2d2d2d;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 -1px 0 rgba(0, 0, 0, 0.35);
}

.roadsafe-navigation-case:hover {
  border-color: var(--blender-orange);
  background: #353535;
}

.roadsafe-navigation-case-status {
  margin-top: 6px;
  padding: 2px 5px;
  border-color: #4d4d4d;
  background: #3a3a3a;
  font-size: 8px;
}

.roadsafe-navigation-footer {
  min-height: 35px;
  gap: 7px;
  padding: 4px 7px;
  border-top-color: #111;
  background: #202020;
}

.roadsafe-system-indicator {
  width: 7px;
  height: 7px;
  flex-basis: 7px;
  border: 0;
  background: #65a26d;
  outline-color: #111;
}

/* Compact Blender-like top bar. */
.roadsafe-workspace-header {
  min-height: var(--js-header-height);
  gap: 8px;
  padding: 4px 6px;
  border-bottom-color: #111;
  background: var(--blender-topbar);
  backdrop-filter: none;
}

.roadsafe-workspace-header-left {
  gap: 6px;
}

.roadsafe-workspace-header-right {
  gap: 3px;
}

.roadsafe-workspace-title {
  padding: 2px 8px;
  border-left: 2px solid var(--blender-orange);
}

.roadsafe-workspace-title h1 {
  margin-top: 1px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0;
}

.roadsafe-workspace-title > p:last-child {
  display: none;
}

.roadsafe-active-case-chip {
  min-height: 30px;
  padding: 3px 6px;
  border-color: #171717;
  border-radius: 2px;
  background: linear-gradient(#3d3d3d, #303030);
  box-shadow:
    inset 0 1px 0 var(--blender-inset-highlight),
    inset 0 -1px 0 var(--blender-inset-shadow);
}

.roadsafe-active-case-chip:hover {
  border-color: var(--blender-orange);
  background: linear-gradient(#484848, #373737);
}

.roadsafe-header-clock {
  min-width: 70px;
  padding: 0 7px;
  border-right-color: #111;
}

.roadsafe-profile-trigger {
  min-height: 30px;
  gap: 5px;
  padding: 2px 4px;
  border-color: #171717;
  border-radius: 2px;
  background: linear-gradient(#424242, #343434);
  box-shadow:
    inset 0 1px 0 var(--blender-inset-highlight),
    inset 0 -1px 0 var(--blender-inset-shadow);
}

.roadsafe-profile-trigger:hover {
  border-color: #686868;
  background: linear-gradient(#4d4d4d, #3c3c3c);
}

.roadsafe-profile-avatar {
  width: 24px;
  height: 24px;
  border-color: var(--blender-orange);
  border-radius: 2px;
  background: #333;
  color: #f1f1f1;
}

.roadsafe-profile-popover {
  top: calc(100% + 3px);
  padding: 3px;
  border-color: #111;
  border-radius: 2px;
  background: #2b2b2b;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.5);
}

.roadsafe-profile-popover a,
.roadsafe-profile-popover button {
  min-height: 27px;
  margin-top: 1px;
  padding: 4px 6px;
  border-radius: 2px;
}

.roadsafe-page-stage {
  padding: 7px;
}

.roadsafe-page-stage.is-dashboard {
  padding: 5px;
}

/* Inspector regions echo Blender's Properties editor. */
.roadsafe-inspector {
  border-left-color: #111;
  background: #292929;
}

.roadsafe-inspector-header {
  min-height: var(--js-header-height);
  padding: 4px 6px;
  border-bottom-color: #111;
  background: var(--blender-topbar);
}

.roadsafe-inspector-scroll {
  padding: 5px;
}

.roadsafe-inspector-section {
  padding: 7px;
  border-color: #171717;
  border-radius: 2px;
  background: #303030;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 -1px 0 rgba(0, 0, 0, 0.32);
}

.roadsafe-inspector-section + .roadsafe-inspector-section {
  margin-top: 4px;
}

.roadsafe-inspector-section-heading {
  margin: -7px -7px 6px;
  padding: 5px 7px;
  border-bottom: 1px solid #191919;
  background: #282828;
}

.roadsafe-inspector-row {
  padding: 5px 0;
  border-bottom-color: #202020;
}

.roadsafe-inspector-metrics {
  gap: 3px;
  margin-top: 6px;
}

.roadsafe-inspector-metrics > div {
  min-height: 42px;
  padding: 5px;
  border-color: #1d1d1d;
  border-radius: 2px;
  background: #383838;
}

.roadsafe-inspector-actions {
  gap: 2px;
  margin-top: 6px;
}

.roadsafe-inspector-actions a {
  min-height: 27px;
  padding: 4px 6px;
  border-color: #171717;
  border-radius: 2px;
  background: linear-gradient(#444, #363636);
  box-shadow:
    inset 0 1px 0 var(--blender-inset-highlight),
    inset 0 -1px 0 var(--blender-inset-shadow);
}

.roadsafe-inspector-actions a:hover {
  border-color: var(--blender-orange);
  background: linear-gradient(#505050, #3f3f3f);
}

/* Buttons: compact, lightly bevelled and mechanically precise. */
.ui-button,
.ui-icon-button,
.reconstruction-workspace__button,
.reconstruction-workspace__icon-button,
.reconstruction-workspace__view-switch button {
  min-height: 26px;
  border-color: #171717 !important;
  border-radius: 2px !important;
  background: linear-gradient(
    180deg,
    var(--blender-control-top),
    var(--blender-control-bottom)
  ) !important;
  color: #d6d6d6 !important;
  box-shadow:
    inset 0 1px 0 var(--blender-inset-highlight),
    inset 0 -1px 0 var(--blender-inset-shadow) !important;
  font-size: 10px;
  font-weight: 500;
}

.ui-icon-button {
  width: 26px;
}

.ui-button:hover,
.ui-icon-button:hover,
.reconstruction-workspace__button:hover,
.reconstruction-workspace__icon-button:hover,
.reconstruction-workspace__view-switch button:hover {
  border-color: #686868 !important;
  background: linear-gradient(
    180deg,
    var(--blender-control-hover-top),
    var(--blender-control-hover-bottom)
  ) !important;
  color: #fff !important;
}

.ui-button:active,
.ui-icon-button:active,
.reconstruction-workspace__button:active,
.reconstruction-workspace__icon-button:active,
.reconstruction-workspace__view-switch button:active {
  background: var(--blender-control-pressed) !important;
  box-shadow:
    inset 0 1px 3px rgba(0, 0, 0, 0.62) !important;
  transform: translateY(1px);
}

.ui-button-primary {
  border-color: #e8872d !important;
  background: linear-gradient(#e8872d, #e8872d) !important;
  color: #fff !important;
}

.ui-button-primary:hover {
  border-color: #e8872d !important;
  background: linear-gradient(#e8872d, #e8872d) !important;
}

[aria-pressed="true"].ui-button,
[aria-pressed="true"].ui-icon-button,
.reconstruction-workspace__view-switch button.is-active {
  border-color: var(--blender-orange) !important;
  background: #3b3b3b !important;
  box-shadow:
    inset 0 0 0 1px var(--blender-orange-soft),
    inset 0 1px 0 var(--blender-inset-highlight) !important;
  color: #fff !important;
}

/* Inputs use a recessed Blender field treatment. */
.ui-input,
input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
select,
textarea {
  min-height: 26px;
  border-color: #171717 !important;
  border-radius: 2px !important;
  background: #262626 !important;
  color: #dedede !important;
  box-shadow:
    inset 0 1px 3px rgba(0, 0, 0, 0.5),
    0 1px 0 rgba(255, 255, 255, 0.025) !important;
  font-size: 10px;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--blender-orange) !important;
  outline: 1px solid var(--blender-orange) !important;
  outline-offset: 0;
}

.ui-badge {
  min-height: 17px;
  padding: 1px 4px;
  border-color: #181818 !important;
  border-radius: 2px !important;
  background: #3a3a3a !important;
  font-size: 8px;
  font-weight: 500;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.04),
    inset 0 -1px 0 rgba(0, 0, 0, 0.35);
}

/* Flatten oversized web-card styling across existing screens. */
.ui-panel,
.dashboard-stat-card,
.dashboard-command-grid .ui-panel,
.roadsafe-workstation [class*="rounded-xl"],
.roadsafe-workstation [class*="rounded-2xl"],
.roadsafe-workstation [class*="rounded-3xl"],
.reconstruction-editor [class*="rounded-xl"],
.reconstruction-editor [class*="rounded-2xl"],
.reconstruction-editor [class*="rounded-3xl"] {
  border-radius: 3px !important;
}

.ui-panel,
.dashboard-stat-card,
.dashboard-command-grid .ui-panel {
  border-color: #171717 !important;
  background: #303030 !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 -1px 0 rgba(0, 0, 0, 0.32) !important;
}

.dashboard-stat-card:hover {
  border-color: var(--blender-orange) !important;
  background: #363636 !important;
}

.dashboard-stat-icon {
  border-color: #171717 !important;
  background: #3a3a3a !important;
  color: #cfcfcf !important;
}

/* Existing utility-colour controls: Blender blue for actions, orange for focus. */
.roadsafe-workstation button[class*="bg-blue-"],
.roadsafe-workstation a[class*="bg-blue-"],
.reconstruction-editor button[class*="bg-blue-"],
.reconstruction-editor a[class*="bg-blue-"] {
  border-color: #e8872d !important;
  background: linear-gradient(#e8872d, #e8872d) !important;
  color: #fff !important;
}

.roadsafe-workstation button,
.roadsafe-workstation a,
.reconstruction-editor button,
.reconstruction-editor a {
  text-shadow: 0 1px 0 rgba(0, 0, 0, 0.4);
}

.roadsafe-workstation button:focus-visible,
.roadsafe-workstation a:focus-visible,
.reconstruction-editor button:focus-visible,
.reconstruction-editor a:focus-visible {
  outline: 1px solid var(--blender-orange) !important;
