:root {
  --js-blue-muted: #e8872d;
  --js-blue-active: #e8872d;
  --js-blue-selected: #383838;
  --js-blue-soft-bg: #303030;

  --blender-blue: #e8872d;
  --blender-blue-dark: #e8872d;
}

