}

.roadsafe-mobile-overlay {
  display: none;
}

.ui-panel,
.roadsafe-shell .bg-white,
.roadsafe-shell .bg-gray-50,
.roadsafe-shell .bg-gray-100,
.roadsafe-shell .bg-slate-50,
.roadsafe-shell .bg-slate-100,
.reconstruction-editor .bg-white,
.reconstruction-editor .bg-gray-50,
.reconstruction-editor .bg-gray-100,
.reconstruction-editor .bg-slate-50,
.reconstruction-editor .bg-slate-100 {
