:root {
  color-scheme: dark;

  --js-shell: #1b1b1b;
  --js-sidebar: #242424;
  --js-workspace: #303030;
  --js-inspector: #292929;
  --js-panel: #303030;
  --js-panel-raised: #3b3b3b;
  --js-panel-hover: #474747;

  --js-border-subtle: #171717;
  --js-border-default: #4a4a4a;
  --js-border-strong: #5d5d5d;

  --js-blue-muted: #e8872d;
  --js-blue-active: #e8872d;
  --js-blue-selected: #383838;
  --js-blue-soft-bg: #303030;

  --js-text-primary: #dedede;
  --js-text-secondary: #c2c2c2;
  --js-text-muted: #8e8e8e;
  --js-text-disabled: #666666;

  --js-red-muted: #986060;
  --js-red-bg: #50383b;
  --js-amber-muted: #9a825c;
  --js-amber-bg: #51483a;
  --js-green-muted: #62806f;
  --js-green-bg: #3b4f47;
  --js-info-muted: #657f91;

  --js-navigation-width: 220px;
  --js-navigation-collapsed-width: 46px;
  --js-inspector-width: 312px;
  --js-header-height: 54px;
  --js-radius-sm: 2px;
  --js-radius-md: 3px;
  --js-radius-lg: 4px;
}

html,
body,
#root {
  min-height: 100%;
  background: var(--js-shell) !important;
}

body {
  margin: 0;
  color: var(--js-text-primary);
  background: var(--js-shell) !important;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.roadsafe-workstation {
  min-height: 100vh;
  display: grid;
  grid-template-columns:
    var(--js-navigation-width)
    minmax(0, 1fr)
    0;
  background: var(--js-shell);
  color: var(--js-text-primary);
  transition: grid-template-columns 160ms ease;
}

.roadsafe-workstation.is-navigation-collapsed {
  grid-template-columns:
    var(--js-navigation-collapsed-width)
    minmax(0, 1fr)
    0;
}

.roadsafe-workstation.is-inspector-open {
  grid-template-columns:
    var(--js-navigation-width)
    minmax(0, 1fr)
    var(--js-inspector-width);
}

.roadsafe-workstation.is-navigation-collapsed.is-inspector-open {
  grid-template-columns:
    var(--js-navigation-collapsed-width)
    minmax(0, 1fr)
    var(--js-inspector-width);
}

.roadsafe-workstation.is-editor-route,
.roadsafe-workstation.is-navigation-collapsed.is-editor-route {
  grid-template-columns:
    var(--js-navigation-width)
    minmax(0, 1fr)
    0;
}

.roadsafe-workstation.is-navigation-collapsed.is-editor-route {
  grid-template-columns:
    var(--js-navigation-collapsed-width)
    minmax(0, 1fr)
    0;
}

.roadsafe-navigation {
  position: sticky;
  top: 0;
  z-index: 40;
  grid-column: 1;
  display: flex;
  min-width: 0;
  height: 100vh;
  flex-direction: column;
  overflow: hidden;
  border-right: 1px solid var(--js-border-subtle);
  background: var(--js-sidebar);
}

.roadsafe-navigation-brand {
  min-height: var(--js-header-height);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-bottom: 1px solid var(--js-border-subtle);
}

.roadsafe-brand-link {
  min-width: 0;
  display: flex;
  flex: 1;
  align-items: center;
  gap: 11px;
  color: inherit;
  text-decoration: none;
}

.roadsafe-brand-mark {
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  display: grid;
  place-items: center;
  border: 1px solid var(--js-border-strong);
  border-radius: var(--js-radius-md);
  background: var(--js-blue-soft-bg);
  color: var(--js-text-primary);
}

.roadsafe-brand-copy,
.roadsafe-station-copy,
.roadsafe-navigation-footer-copy,
.roadsafe-profile-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.roadsafe-brand-copy strong {
  overflow: hidden;
  color: var(--js-text-primary);
  font-size: 13px;
  font-weight: 760;
  letter-spacing: 0.055em;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.roadsafe-brand-copy small,
.roadsafe-station-copy small,
.roadsafe-navigation-footer-copy small,
.roadsafe-profile-copy small {
  margin-top: 2px;
  color: var(--js-text-muted);
  font-size: 9px;
  font-weight: 650;
  letter-spacing: 0.075em;
  text-transform: uppercase;
}

.roadsafe-navigation-collapse {
  flex: 0 0 auto;
}

.roadsafe-navigation-mobile-close,
.roadsafe-mobile-menu-button {
  display: none !important;
}

.roadsafe-navigation-station {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 58px;
  padding: 10px 13px;
  border-bottom: 1px solid var(--js-border-subtle);
  background: color-mix(in srgb, var(--js-sidebar) 88%, var(--js-panel));
}

.roadsafe-station-symbol {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  display: grid;
  place-items: center;
  border: 1px solid var(--js-border-default);
  border-radius: var(--js-radius-sm);
  background: var(--js-panel);
  color: var(--js-text-secondary);
}

.roadsafe-station-copy strong {
  overflow: hidden;
  color: var(--js-text-secondary);
  font-size: 10px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roadsafe-navigation-groups {
  min-height: 0;
  flex: 1;
  overflow-y: auto;
  padding: 10px 8px 12px;
}

.roadsafe-navigation-group + .roadsafe-navigation-group {
  margin-top: 13px;
}

.roadsafe-navigation-group-label,
.roadsafe-eyebrow {
  margin: 0;
  color: var(--js-text-muted);
  font-size: 8px;
  font-weight: 760;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.roadsafe-navigation-group-label {
  padding: 0 9px 6px;
}

.roadsafe-navigation-links {
  display: grid;
  gap: 3px;
}

.roadsafe-navigation-link {
  min-height: 36px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: var(--js-radius-sm);
  color: var(--js-text-secondary);
  font-size: 10px;
  font-weight: 650;
  text-decoration: none;
  transition:
    background-color 110ms ease,
    border-color 110ms ease,
    color 110ms ease;
}

.roadsafe-navigation-link:hover {
  border-color: var(--js-border-subtle);
  background: var(--js-panel);
  color: var(--js-text-primary);
}

.roadsafe-navigation-link.is-active {
  border-color: var(--js-blue-muted);
  background: var(--js-blue-selected);
  color: var(--js-text-primary);
}

.roadsafe-navigation-link.is-active::before {
  width: 2px;
  align-self: stretch;
  margin: -3px 0 -3px -7px;
  border-radius: 2px;
  background: var(--js-blue-active);
  content: "";
}

.roadsafe-navigation-link-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roadsafe-navigation-case {
  margin: 0 9px 10px;
  display: flex;
  flex-direction: column;
  padding: 11px;
  border: 1px solid var(--js-border-default);
  border-radius: var(--js-radius-md);
  background: var(--js-panel);
  color: inherit;
  text-decoration: none;
}

.roadsafe-navigation-case:hover {
  border-color: var(--js-blue-muted);
  background: var(--js-panel-hover);
}

.roadsafe-navigation-case strong {
  margin-top: 5px;
  color: var(--js-text-primary);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
    "Liberation Mono", monospace;
  font-size: 11px;
}

.roadsafe-navigation-case small {
  margin-top: 4px;
  overflow: hidden;
  color: var(--js-text-muted);
  font-size: 9px;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roadsafe-navigation-case-status {
  align-self: flex-start;
  margin-top: 8px;
  padding: 3px 6px;
  border: 1px solid var(--js-border-default);
  border-radius: var(--js-radius-sm);
  background: var(--js-blue-soft-bg);
  color: var(--js-text-secondary);
  font-size: 8px;
  font-weight: 700;
}

.roadsafe-navigation-footer {
  min-height: 57px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 13px;
  border-top: 1px solid var(--js-border-subtle);
}

.roadsafe-system-indicator {
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  border: 2px solid var(--js-sidebar);
  border-radius: 999px;
  background: var(--js-green-muted);
  outline: 1px solid var(--js-border-default);
}

.roadsafe-navigation-footer-copy strong {
  color: var(--js-text-secondary);
  font-size: 9px;
  font-weight: 700;
}

.roadsafe-center {
  grid-column: 2;
  min-width: 0;
  min-height: 100vh;
  background: var(--js-workspace);
}

.roadsafe-workspace-header {
  position: sticky;
  top: 0;
  z-index: 30;
  min-height: var(--js-header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 8px 18px;
  border-bottom: 1px solid var(--js-border-subtle);
  background: color-mix(in srgb, var(--js-workspace) 96%, transparent);
  backdrop-filter: blur(10px);
}

.roadsafe-workspace-header-left,
.roadsafe-workspace-header-right {
  min-width: 0;
  display: flex;
  align-items: center;
}

.roadsafe-workspace-header-left {
  flex: 1;
  gap: 14px;
  min-width: 0;
}

.roadsafe-workspace-header-right {
  flex: 0 0 auto;
  gap: 10px;
  display: flex;
  align-items: center;
}

.roadsafe-workspace-title {
  min-width: 0;
  padding-left: 11px;
  border-left: 2px solid var(--js-blue-muted);
}

.roadsafe-workspace-title h1 {
  margin: 0;
  overflow: hidden;
  color: var(--js-text-primary);
  font-size: 17px;
  font-weight: 740;
  letter-spacing: -0.015em;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.2;
}

.roadsafe-workspace-title > p:last-child {
  margin: 3px 0 0;
  overflow: hidden;
  color: var(--js-text-muted);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roadsafe-active-case-chip {
  min-height: 38px;
  display: grid;
  grid-template-columns: auto auto;
  column-gap: 9px;
  align-content: center;
  padding: 7px 11px;
  border: 1px solid var(--js-border-default);
  border-radius: var(--js-radius-sm);
  background: var(--js-panel);
  color: inherit;
  text-decoration: none;
}

.roadsafe-active-case-chip:hover {
  border-color: var(--js-blue-muted);
  background: var(--js-panel-hover);
}

.roadsafe-active-case-chip span,
.roadsafe-active-case-chip small {
  color: var(--js-text-muted);
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.roadsafe-active-case-chip strong {
  color: var(--js-text-primary);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
    "Liberation Mono", monospace;
  font-size: 10px;
}

.roadsafe-active-case-chip small {
  grid-column: 1 / -1;
  margin-top: 2px;
  letter-spacing: 0;
  text-transform: none;
}

.roadsafe-header-clock {
  min-width: 92px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  padding: 0 14px;
  border-right: 1px solid var(--js-border-subtle);
}

.roadsafe-header-clock strong {
  color: var(--js-text-secondary);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
    "Liberation Mono", monospace;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.15;
}

.roadsafe-header-clock span {
  margin-top: 2px;
  color: var(--js-text-muted);
  font-size: 9px;
  font-weight: 650;
  text-transform: uppercase;
  line-height: 1;
}

.roadsafe-header-icon {
  flex: 0 0 auto;
}

.roadsafe-notification-button {
  position: relative;
}

.roadsafe-notification-button > span {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 16px;
  height: 16px;
  display: grid;
  place-items: center;
  padding: 0 4px;
  border: 1px solid var(--js-border-strong);
  border-radius: 999px;
  background: var(--js-blue-active);
  color: var(--js-text-primary);
  font-size: 7px;
  font-weight: 800;
}

.roadsafe-inspector-toggle {
  min-height: 34px;
  display: inline-flex !important;
  align-items: center;
  gap: 7px;
  padding: 0 9px !important;
}

.roadsafe-profile-menu {
  position: relative;
}

.roadsafe-profile-trigger {
  min-height: 40px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 7px;
  border: 1px solid var(--js-border-default);
  border-radius: var(--js-radius-sm);
  background: var(--js-panel);
  color: var(--js-text-secondary);
  cursor: pointer;
}

.roadsafe-profile-trigger:hover {
  border-color: var(--js-border-strong);
  background: var(--js-panel-hover);
}

.roadsafe-profile-avatar {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border: 1px solid var(--js-blue-muted);
  border-radius: var(--js-radius-sm);
  background: var(--js-blue-soft-bg);
  color: var(--js-text-primary);
  font-size: 9px;
  font-weight: 800;
}

.roadsafe-profile-copy {
  width: 116px;
  align-items: flex-start;
}

.roadsafe-profile-copy strong {
  width: 100%;
  margin-top: 2px;
  overflow: hidden;
  color: var(--js-text-primary);
  font-size: 9px;
  font-weight: 700;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roadsafe-profile-popover {
  position: absolute;
  top: calc(100% + 7px);
  right: 0;
  z-index: 70;
  width: 230px;
  padding: 5px;
  border: 1px solid var(--js-border-strong);
  border-radius: var(--js-radius-md);
  background: var(--js-panel-raised);
  box-shadow: 0 12px 30px rgba(14, 18, 22, 0.28);
}

.roadsafe-profile-popover-head {
  display: flex;
  flex-direction: column;
  padding: 9px;
  border-bottom: 1px solid var(--js-border-subtle);
}

.roadsafe-profile-popover-head strong {
  overflow: hidden;
  color: var(--js-text-primary);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roadsafe-profile-popover-head span {
  margin-top: 3px;
  overflow: hidden;
  color: var(--js-text-muted);
  font-size: 8px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roadsafe-profile-popover a,
.roadsafe-profile-popover button {
  width: 100%;
  min-height: 33px;
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 3px;
  padding: 7px 9px;
  border: 0;
  border-radius: var(--js-radius-sm);
  background: transparent;
  color: var(--js-text-secondary);
  font-size: 9px;
  text-align: left;
  text-decoration: none;
  cursor: pointer;
}

.roadsafe-profile-popover a:hover,
.roadsafe-profile-popover button:hover {
  background: var(--js-panel-hover);
  color: var(--js-text-primary);
}

.roadsafe-profile-popover button:last-child {
  color: #d3a5a5;
}

.roadsafe-workspace-main {
  min-width: 0;
  min-height: calc(100vh - var(--js-header-height));
  background: var(--js-workspace);
}

.roadsafe-workspace-main.is-editor {
  min-height: 100vh;
}

.roadsafe-page-stage {
  min-width: 0;
  padding: 14px;
}

.roadsafe-page-stage.is-dashboard {
  padding: 10px;
}

.roadsafe-page-stage.is-editor {
  padding: 0;
}

.roadsafe-inspector {
  position: sticky;
  top: 0;
  z-index: 35;
  grid-column: 3;
  width: var(--js-inspector-width);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-left: 1px solid var(--js-border-default);
  background: var(--js-inspector);
}

.roadsafe-inspector-header {
  min-height: var(--js-header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  border-bottom: 1px solid var(--js-border-subtle);
}

.roadsafe-inspector-header h2,
.roadsafe-inspector-section h3,
.roadsafe-inspector-empty h3 {
  margin: 4px 0 0;
  color: var(--js-text-primary);
  font-size: 11px;
  font-weight: 720;
}

.roadsafe-inspector-scroll {
  min-height: 0;
  flex: 1;
  overflow-y: auto;
  padding: 10px;
}

.roadsafe-inspector-section {
  padding: 11px;
  border: 1px solid var(--js-border-default);
  border-radius: var(--js-radius-md);
  background: var(--js-panel);
}

.roadsafe-inspector-section + .roadsafe-inspector-section {
  margin-top: 9px;
}

.roadsafe-inspector-section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
}

.roadsafe-inspector-case-title {
  margin: 10px 0 0;
  color: var(--js-text-secondary);
  font-size: 9px;
  font-weight: 650;
  line-height: 1.5;
}

.roadsafe-inspector-definition-list {
  margin: 10px 0 0;
  border-top: 1px solid var(--js-border-subtle);
}

.roadsafe-inspector-row {
  display: grid;
  grid-template-columns: minmax(82px, 0.8fr) minmax(0, 1.2fr);
  gap: 8px;
  padding: 7px 0;
  border-bottom: 1px solid var(--js-border-subtle);
}

.roadsafe-inspector-row dt,
.roadsafe-inspector-row dd {
  margin: 0;
  font-size: 8px;
  line-height: 1.4;
}

.roadsafe-inspector-row dt {
  color: var(--js-text-muted);
  font-weight: 650;
}

.roadsafe-inspector-row dd {
  overflow-wrap: anywhere;
  color: var(--js-text-secondary);
  font-weight: 650;
  text-align: right;
}

.roadsafe-status-stack {
  display: grid;
  gap: 7px;
  margin-top: 10px;
}

.roadsafe-status-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: var(--js-text-muted);
  font-size: 8px;
}

.roadsafe-status-line strong {
  color: var(--js-text-secondary);
  font-size: 8px;
  text-align: right;
}

.roadsafe-inline-alert {
  margin: 9px 0 0;
  padding: 7px 8px;
  border: 1px solid var(--js-red-muted);
  border-radius: var(--js-radius-sm);
  background: var(--js-red-bg);
  color: #e1c5c5;
  font-size: 8px;
  line-height: 1.45;
}

.roadsafe-inspector-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6px;
  margin-top: 10px;
}

.roadsafe-inspector-metrics > div {
  min-height: 52px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 7px;
  border: 1px solid var(--js-border-subtle);
  border-radius: var(--js-radius-sm);
  background: var(--js-panel-raised);
}

.roadsafe-inspector-metrics strong {
  color: var(--js-text-primary);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
    "Liberation Mono", monospace;
  font-size: 13px;
}

.roadsafe-inspector-metrics span {
  margin-top: 3px;
  color: var(--js-text-muted);
  font-size: 7px;
  font-weight: 650;
}

.roadsafe-inspector-actions {
  display: grid;
  gap: 5px;
  margin-top: 10px;
}

.roadsafe-inspector-actions a {
  min-height: 34px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 8px;
  border: 1px solid var(--js-border-subtle);
  border-radius: var(--js-radius-sm);
  background: var(--js-panel-raised);
  color: var(--js-text-secondary);
  font-size: 8px;
  font-weight: 650;
  text-decoration: none;
}

.roadsafe-inspector-actions a:hover {
  border-color: var(--js-blue-muted);
  background: var(--js-blue-selected);
  color: var(--js-text-primary);
}

.roadsafe-inspector-empty {
  min-height: 240px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px 18px;
  border: 1px dashed var(--js-border-default);
  border-radius: var(--js-radius-md);
  color: var(--js-text-muted);
  text-align: center;
}

.roadsafe-inspector-empty p {
  max-width: 210px;
  margin: 8px 0 14px;
  color: var(--js-text-muted);
  font-size: 9px;
  line-height: 1.55;
}

.roadsafe-inspector-footer {
  min-height: 58px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  padding: 9px 11px;
  border-top: 1px solid var(--js-border-subtle);
}

.roadsafe-inspector-footer > div {
  display: flex;
  flex-direction: column;
}

.roadsafe-inspector-footer span {
