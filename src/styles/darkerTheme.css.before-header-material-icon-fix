  border-color: var(--js-border-default) !important;
  box-shadow: 0 8px 20px rgba(16, 20, 24, 0.14) !important;
}

.ui-panel-header,
.roadsafe-shell .border-gray-100,
.roadsafe-shell .border-gray-200,
.roadsafe-shell .border-gray-300,
.roadsafe-shell .border-slate-100,
.roadsafe-shell .border-slate-200,
.roadsafe-shell .border-slate-300,
.reconstruction-editor .border-gray-100,
.reconstruction-editor .border-gray-200,
.reconstruction-editor .border-gray-300,
.reconstruction-editor .border-slate-100,
.reconstruction-editor .border-slate-200,
.reconstruction-editor .border-slate-300 {
