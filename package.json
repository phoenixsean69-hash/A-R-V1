{
  "name": "roadsafe-ar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "physics:verify": "node scripts/verify-phase0-foundation.mjs && tsc -p tsconfig.phase0.json",
    "physics:verify:full": "node scripts/verify-phase0-foundation.mjs && npm run build",
    "route:verify": "node scripts/verify-route-topology.mjs && tsc -p tsconfig.phase0.json",
    "motion:verify": "node scripts/verify-motion-kinematics.mjs && tsc -p tsconfig.phase0.json",
    "timing:verify": "node scripts/verify-metric-route-timing.mjs && tsc -p tsconfig.phase0.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "appwrite": "^26.2.0",
    "ar.js": "^2.2.2",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "lucide-react": "^1.25.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
